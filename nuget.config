<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear прибирає джерела із загальних налаштувань машини:
         перелік буде саме таким, як тут, і на іншому комп’ютері
         збирання поводитиметься так само. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="./packages" />
  </packageSources>
</configuration>
