<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe прибирає чорне вікно консолі позаду вікна програми у Windows.
         У Linux і macOS різниці немає – так і має бути. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HomeBudget.Desktop</RootNamespace>
    <AssemblyName>budget-ui</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <!-- Засоби розробника – лише в налагоджувальній збірці. -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20">
      <IncludeAssets Condition="'$(Configuration)'!='Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)'!='Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeBudget.Core\HomeBudget.Core.csproj" />
  </ItemGroup>
</Project>
